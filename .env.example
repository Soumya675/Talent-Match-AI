# AI Job & Resume Matching Platform - Environment Configuration

# Application URLs
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# Database (PostgreSQL 16 with pgvector & pgcrypto)
DATABASE_URL="postgresql+asyncpg://postgres:postgres_secure_pass@localhost:5432/career_ai_db"

# Redis Cache & Task Queue
REDIS_URL="redis://localhost:6379/0"

# JWT & Authentication
JWT_SECRET="generate_a_minimum_32_char_random_secret_key_here"
JWT_REFRESH_SECRET="generate_another_minimum_32_char_refresh_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60

# AI Provider (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"
EMBEDDING_DIMENSION=768
AI_MODEL_NAME="gemini-3.8-flash"

# Object Storage (S3 / MinIO / GCS compatible)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="career-ai-resumes"
STORAGE_ACCESS_KEY="minio_admin"
STORAGE_SECRET_KEY="minio_secret_key"
STORAGE_REGION="us-east-1"
MAX_RESUME_FILE_SIZE_MB=10

# Email & SMS Service (Twilio / Sendgrid / Resend)
EMAIL_API_KEY="your-email-provider-api-key"
EMAIL_FROM="no-reply@careerai.io"
SMS_API_KEY="your-sms-provider-api-key"

# Matching Engine Configuration (Configurable Weights)
WEIGHT_REQUIRED_SKILLS=0.40
WEIGHT_PREFERRED_SKILLS=0.20
WEIGHT_EXPERIENCE=0.15
WEIGHT_EDUCATION=0.10
WEIGHT_SEMANTIC_SIMILARITY=0.10
WEIGHT_LOCATION=0.05

